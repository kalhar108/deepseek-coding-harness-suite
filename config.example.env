# API Configuration for DeepSeek Harness Suite
# Support for OpenRouter, Gemini Pro, OpenAI, and DeepSeek endpoints

OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Default Model Provider (openrouter, gemini, openai, deepseek, or mock)
DEFAULT_PROVIDER=mock

# Selected LLM Model Name
DEFAULT_MODEL=deepseek/deepseek-r1
# Gemini fallback: gemini-2.5-pro / gemini-1.5-pro
# OpenRouter fallback: openrouter/auto
